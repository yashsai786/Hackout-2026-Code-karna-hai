# Leakpoint API + the trained model it serves.
FROM python:3.12-slim

WORKDIR /app
COPY backend/requirements.txt backend/requirements-ocr.txt backend/
RUN pip install --no-cache-dir -r backend/requirements.txt -r backend/requirements-ocr.txt

# ai/ carries the committed artefact, so the image needs no training step.
COPY ai/ ai/
COPY backend/ backend/

EXPOSE 8001
WORKDIR /app/backend
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001"]
