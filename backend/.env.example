# Copy to backend/.env to override. Every value below has a working default.

# Persistence. MongoDB is the system of record when reachable; if it is not, the API keeps the same
# documents in backend/data/*.json and says so in /api/health. Nothing else changes.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=leakpoint

# Browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173
