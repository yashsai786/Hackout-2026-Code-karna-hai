# Copy to backend/.env to override. Every value below has a working default, so the API starts
# with no configuration at all.

# Optional persistence. Leave commented out and the service reports "not configured" and runs
# normally — the demonstration stores nothing server-side. Uncomment only if you have MongoDB.
# MONGO_URL=mongodb://127.0.0.1:27017
# DB_NAME=leakpoint

# Browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
