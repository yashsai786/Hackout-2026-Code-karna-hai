# Vite fails fast when any of these are missing (see frontend/vite.config.ts).
# Copy to frontend/.env before running `yarn start`.

# Base URL of the FastAPI foundation. The demonstration never calls it, but the
# dev server validates the value and derives an allowed host from it.
REACT_APP_BACKEND_URL=http://localhost:8001

# Dev-server bind address and port.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000

# Extra hostnames the dev server will serve (comma-separated).
FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1
